# Copy this file to .env and fill in your actual API keys.
# .env is gitignored -- never commit it.

DEEPSEEK_API_KEY=sk-...            # https://platform.deepseek.com/api_keys
ANTHROPIC_API_KEY=sk-ant-...       # https://platform.claude.com/settings/workspaces/default/keys
GROQ_API_KEY=gsk_...               # https://console.groq.com/keys
MISTRAL_API_KEY=...                # https://admin.mistral.ai/organization/api-keys
KIMI_API_KEY=sk-...                # https://platform.kimi.ai/console/api-keys
OPENAI_API_KEY=sk-proj-...         # https://platform.openai.com/api-keys
LITELLM_MASTER_KEY=sk-litellm-...  # echo "sk-litellm-$(openssl rand -hex 16)"
